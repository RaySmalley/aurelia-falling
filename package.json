{
  "name": "aurelia-falling",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "vinext dev --port 4000",
    "build": "vinext build",
    "start": "vinext start --port 4000",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 tests/phase-zero.test.mjs tests/phase-one.test.mjs tests/phase-two.test.mjs tests/phase-three.test.mjs tests/phase-four.test.mjs tests/phase-five.test.mjs tests/phase-six.test.mjs tests/phase-nine.test.mjs tests/phase-ten.test.mjs tests/phase-eleven.test.mjs tests/phase-twelve.test.mjs tests/phase-twelve-worker.test.mjs",
    "test:viewport": "node scripts/run-viewport-tests.mjs",
    "benchmark:simulation": "node scripts/run-simulation-benchmarks.mjs",
    "benchmark:worker": "node scripts/run-worker-benchmark.mjs",
    "benchmark:pathfinding": "node scripts/run-simulation-benchmarks.mjs --scenarios formation-move,direct-attack --targeted-count 200 --max-targeted-worst-ms 25",
    "benchmark:baseline": "node scripts/run-simulation-benchmarks.mjs --scenarios idle-armies --output benchmarks/baseline.json",
    "replay:verify": "node scripts/verify-simulation-replays.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "phaser": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20260730.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "0.2.1",
    "vite": "8.2.0",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fast-uri": "3.1.4",
    "sharp": "0.35.3",
    "postcss": "8.5.20"
  },
  "type": "module"
}

{
  "name": "aurelia-falling",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "vinext dev --port 4000",
    "build": "vinext build",
    "start": "vinext start --port 4000",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 tests/phase-zero.test.mjs tests/phase-one.test.mjs tests/phase-two.test.mjs tests/phase-three.test.mjs tests/phase-four.test.mjs tests/phase-five.test.mjs tests/phase-six.test.mjs",
    "assets:validate": "node scripts/validate-phase-six-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.10",
    "phaser": "^4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/workers-types": "5.20260719.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.28",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "react-server-dom-webpack": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "wrangler": "4.112.0"
  },
  "type": "module"
}
